import { Theme } from "../theme.slint";

// 2px 轨道 + 3px 细手柄，端点用等宽小字标出
export component FineSlider inherits Rectangle {
    in property <float> value: 30;
    in property <float> minimum: 1;
    in property <float> maximum: 120;
    callback changed(float);

    height: 34px;
    background: transparent;

    private property <float> ratio: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);
    private property <length> head-x: root.width * root.ratio;
    private property <length> track-y: 12px;

    Rectangle {
        x: 0;
        y: root.track-y;
        width: parent.width;
        height: 2px;
        background: Theme.line-strong;
    }

    Rectangle {
        x: 0;
        y: root.track-y;
        width: root.head-x;
        height: 2px;
        background: Theme.accent;
    }

    Rectangle {
        x: root.head-x - 1.5px;
        y: root.track-y - 6px;
        width: 3px;
        height: 14px;
        background: Theme.accent-hi;
    }

    Text {
        x: 0;
        y: root.track-y + 7px;
        text: "\{round(root.minimum)}";
        color: Theme.fg-dim;
        font-family: Theme.font-mono;
        font-size: Theme.fs-micro;
    }

    Text {
        x: 0;
        y: root.track-y + 7px;
        width: parent.width;
        text: "\{round(root.maximum)}";
        color: Theme.fg-dim;
        font-family: Theme.font-mono;
        font-size: Theme.fs-micro;
        horizontal-alignment: right;
    }

    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        moved => {
            root.changed(clamp(self.mouse-x / root.width, 0, 1) * (root.maximum - root.minimum) + root.minimum);
        }
        clicked => {
            root.changed(clamp(self.mouse-x / root.width, 0, 1) * (root.maximum - root.minimum) + root.minimum);
        }
    }
}
