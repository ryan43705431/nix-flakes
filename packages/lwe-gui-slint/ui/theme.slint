// 设计令牌：近黑画布 + 单一强调色，层级靠排版与留白，不靠卡片和边框
export global Theme {
    // 表面
    in-out property <color> bg: #0b0b0c;
    in-out property <color> bg-rail: #0e0e10;
    in-out property <color> bg-hover: #131316;
    in-out property <color> bg-selected: #17171b;

    // 分隔线
    in-out property <color> line: #1c1c1f;
    in-out property <color> line-strong: #2a2a2e;

    // 文字三级
    in-out property <color> fg: #ededf0;
    in-out property <color> fg-mid: #9a9aa2;
    in-out property <color> fg-dim: #5a5a62;

    // 强调色只此一支
    in-out property <color> accent: #d8a657;
    in-out property <color> accent-hi: #e8c27a;
    in-out property <color> ok: #8fbf7f;
    in-out property <color> danger: #d9646b;

    // 字体：正文 Noto Sans CJK SC，数字与标签 Maple Mono
    in-out property <string> font-sans: "Noto Sans CJK SC";
    in-out property <string> font-mono: "Maple Mono";

    // 字号
    in-out property <length> fs-micro: 9.5px;
    in-out property <length> fs-label: 11px;
    in-out property <length> fs-row: 12.5px;
    in-out property <length> fs-title: 19px;
    in-out property <length> fs-number: 30px;

    // 字距
    in-out property <length> ls-label: 2.2px;
    in-out property <length> ls-unit: 1.2px;
    in-out property <length> ls-micro: 0.6px;

    // 结构尺寸
    in-out property <length> top-bar-h: 56px;
    in-out property <length> info-bar-h: 104px;
    in-out property <length> row-h: 56px;
    in-out property <length> thumb-w: 72px;
    in-out property <length> thumb-h: 40px;
    in-out property <length> pad: 24px;
    in-out property <length> radius: 2px;

    in-out property <duration> dur: 140ms;
}
